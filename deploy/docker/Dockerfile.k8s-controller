# The dynamically linked GNU controller binary is staged under
# deploy/docker/.build/prebuilt-binaries/<arch>/.

# The base has no libgcc_s; the cargo-zigbuild staging links its unwinder
# statically. Set K8S_CONTROLLER_BASE_IMAGE to a distroless cc image for a
# binary built without zig. The controller needs only glibc and CA roots.
# It runs as the distroless nonroot user and writes nothing to disk.
ARG K8S_CONTROLLER_BASE_IMAGE=gcr.io/distroless/base-nossl-debian13@sha256:af5cb8dd589b8520b8c06bebb9efb73d7e16406cab58e85c51761fff49d370a0
FROM ${K8S_CONTROLLER_BASE_IMAGE} AS k8s-controller

ARG TARGETARCH

COPY --chmod=0555 deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-k8s-controller /openshell-k8s-controller

USER 65532:65532
ENTRYPOINT ["/openshell-k8s-controller"]
